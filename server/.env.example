# Supabase (required)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Google Forms sync (optional — omit to skip cron)
# Path to service account JSON key file
GOOGLE_CLOUD_KEY_PATH=
# Or use the standard GCP variable instead of GOOGLE_CLOUD_KEY_PATH:
# GOOGLE_APPLICATION_CREDENTIALS=

# Path to form-config.json (defaults to server/form-config.json if unset)
FORM_CONFIG_PATH=

# Optional: form id for `npm run discover-form-fields` if config formId is still a placeholder
# GOOGLE_FORM_ID=

# Cron expression for sync (default: every 10 minutes)
FORMS_SYNC_CRON=*/10 * * * *

PORT=3000
