# Supabase (required)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Auth (required)
JWT_SECRET=

# CORS — comma-separated allowed origins (localhost:* is always allowed in dev)
CORS_ALLOWED_ORIGINS=https://ucla-180-dc-ats.vercel.app

# Google Forms sync (optional — omit to skip cron)
# Path to service account JSON key file
GOOGLE_CLOUD_KEY_PATH=./gcp/my-service-account.json
# Or use the standard GCP variable instead of GOOGLE_CLOUD_KEY_PATH:
# GOOGLE_APPLICATION_CREDENTIALS=

# Path to form-config.json (defaults to server/form-config.json if unset)
FORM_CONFIG_PATH=

# Cron expression for in-process node-cron sync (default: every 10 minutes)
FORMS_SYNC_CRON=*/15 * * * *

# Set to 1 when using Vercel cron (client/vercel.json) instead of node-cron
DISABLE_FORMS_SYNC_CRON=

# Shared secret for POST /cron/forms-sync (must match Vercel CRON_SECRET)
CRON_SECRET=

# Gmail advance notifications (see server/docs/gmail-setup.md)
# Path A — personal @gmail.com (OAuth):
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_OAUTH_REDIRECT_URI=http://localhost:3000/oauth2callback
# GMAIL_REFRESH_TOKEN=
# GMAIL_SEND_AS=matthewdo823@gmail.com
# GMAIL_FROM_NAME=180DC Recruiting
#
# Path B — Google Workspace (service account + delegation):
# GOOGLE_CLOUD_KEY_PATH=./gcp/my-service-account.json
# GMAIL_IMPERSONATE_USER=recruiting@yourdomain.edu
# GMAIL_FROM_NAME=180DC Recruiting

PORT=3000

# AI candidate summary — free via Google AI Studio (https://aistudio.google.com/apikey)
# Omit GEMINI_API_KEY to hide the summary section on the application page.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# CANDIDATE_SUMMARY_CACHE_TTL_HOURS=48
