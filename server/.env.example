# Supabase (required)
SUPABASE_URL=
# Create a server-only secret key in Supabase Settings > API Keys.
SUPABASE_SECRET_KEY=
# Temporary migration fallback only. Deactivate legacy keys after cutover.
# SUPABASE_SERVICE_KEY=

# Auth (required)
JWT_SECRET=
# Optional token lifetime (default: 8h)
JWT_EXPIRES_IN=8h
# Frontend reset-password route used in reset emails
PASSWORD_RESET_URL=http://localhost:5173/reset-password

# CORS — comma-separated production origins (local loopback origins are allowed in dev)
CORS_ALLOWED_ORIGINS=https://ats.example.org

# Google Forms sync (optional — omit to skip cron)
# Path to service account JSON key file
GOOGLE_CLOUD_KEY_PATH=./gcp/my-service-account.json
# Or use the standard GCP variable instead of GOOGLE_CLOUD_KEY_PATH:
# GOOGLE_APPLICATION_CREDENTIALS=

# Legacy fallback path to form-config.json (current config is stored per cycle)
FORM_CONFIG_PATH=

# Cron expression for in-process node-cron sync (default: every 10 minutes)
FORMS_SYNC_CRON=*/10 * * * *

# Set to 1 when an external scheduler owns the sync instead of node-cron
DISABLE_FORMS_SYNC_CRON=

# Shared secret for POST /cron/forms-sync (must match the external scheduler)
CRON_SECRET=

# Legacy defaults for cycles without saved Cycle Management goals
# (FRQ defaults to GRADER_REVIEW_GOAL)
GRADER_REVIEW_GOAL=30
FRQ_REVIEW_GOAL=30

# Gmail advance notifications (see server/docs/gmail-setup.md)
# Path A — personal @gmail.com (OAuth):
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_OAUTH_REDIRECT_URI=http://localhost:3000/oauth2callback
# Enable only while completing the local OAuth setup flow, then remove it:
# GMAIL_OAUTH_SETUP_ENABLED=1
# GMAIL_REFRESH_TOKEN=
# GMAIL_SEND_AS=sender@example.com
# GMAIL_FROM_NAME=180DC Recruiting
#
# Path B — Google Workspace (service account + delegation):
# GOOGLE_CLOUD_KEY_PATH=./gcp/my-service-account.json
# GMAIL_IMPERSONATE_USER=recruiting@yourdomain.edu
# Optional Drive/headshot delegation. This is intentionally independent from Gmail:
# GOOGLE_DRIVE_IMPERSONATE_USER=forms-owner@yourdomain.edu
# GMAIL_FROM_NAME=180DC Recruiting

PORT=3000

# AI candidate summary — free via Google AI Studio (https://aistudio.google.com/apikey)
# Omit GEMINI_API_KEY to hide the summary section on the application page.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# CANDIDATE_SUMMARY_CACHE_TTL_HOURS=48
